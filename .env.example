# ─── LLM Configuration ───────────────────────────────────────────────────────
DASHSCOPE_API_KEY=your_api_key_here
LLM_BASE_URL=https://llm-axtdj52skmowrf1g.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max

# ─── Security ────────────────────────────────────────────────────────────────
# JWT（生产环境请修改为随机强密码）
SECRET_KEY=jobprep-secret-change-in-prod

# ─── CORS Origins ────────────────────────────────────────────────────────────
# 允许的前端域名（逗号分隔，无空格）
# 开发环境：
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产环境示例（根据实际前端域名修改）：
# CORS_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./jobprep.db

# ─── RAG Knowledge Base ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=interview_kb

# ─── Code Sandbox ────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_MEMORY_MB=128
